{
    "name": "majelis/dzikir-management",
    "description": "Sistem Manajemen Majelis Dzikir dengan Peta Interaktif",
    "version": "1.0.0",
    "require": {
        "php": ">=7.4",
        "phpoffice/phpspreadsheet": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "Majelis\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}